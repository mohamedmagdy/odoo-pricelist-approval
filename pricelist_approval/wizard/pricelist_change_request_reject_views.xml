<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pricelist_change_request_reject_view_form" model="ir.ui.view">
        <field name="name">pricelist.change.request.reject.form</field>
        <field name="model">pricelist.change.request.reject</field>
        <field name="arch" type="xml">
            <form string="Reject Change Request">
                <group>
                    <field name="request_ids" widget="many2many_tags" readonly="1"/>
                    <field name="reason" placeholder="Tell the requester why the change is not accepted"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Reject" class="btn-primary" data-hotkey="q"/>
                    <button special="cancel" string="Discard" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
